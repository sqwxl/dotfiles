# https://ghostty.org/docs/config
{{ if lookPath "fish" }}command = {{ lookPath "fish"}}{{ end }}
shell-integration-features = no-cursor,ssh-env,ssh-terminfo

scrollback-limit = 100000000
scrollbar = never

theme = Gruvbox Dark
{{ if eq .chezmoi.os "darwin" -}}
window-colorspace = display-p3
alpha-blending = native
{{- else -}}
# window-decoration = none
# window-theme = ghostty
# gtk-titlebar-hide-when-maximized = true
gtk-titlebar-style = tabs
{{- end }}

window-width = 100
window-height = 60
{{ if eq .chezmoi.hostname "t14" -}}
window-width = 80
window-height = 30
{{- end }}

{{- $fontSize := 13 }}
{{- if eq .chezmoi.hostname "t14" }}{{ $fontSize = 10 }}{{ end }}

font-family = Jetbrains Mono
font-family = Symbols Nerd Font
font-size = {{ $fontSize }}
font-feature = -calt, -liga, -dlig # disable ligatures

unfocused-split-opacity=0.75

desktop-notifications = false
app-notifications = no-clipboard-copy

window-inherit-working-directory = false
tab-inherit-working-directory = true
split-inherit-working-directory = true

quit-after-last-window-closed = true

macos-option-as-alt = true

# https://ghostty.org/docs/config/keybind
{{ if eq .chezmoi.os "darwin" -}}
keybind = shift+enter=text:\n
{{- end }}
keybind = ctrl+enter=unbind
keybind = shift+page_up=scroll_page_fractional:-0.5
keybind = shift+page_down=scroll_page_fractional:0.5
keybind = shift+ctrl+0=reset_font_size

keybind = shift+ctrl+w=activate_key_table_once:win
keybind = win/t=new_tab
keybind = win/v=new_split:right
keybind = win/s=new_split:down
keybind = win/r=activate_key_table:resize

keybind = resize/c=resize_split:up,20
keybind = resize/t=resize_split:down,20
keybind = resize/h=resize_split:left,20
keybind = resize/n=resize_split:right,20
keybind = resize/==equalize_splits
keybind = resize/escape=deactivate_key_table
keybind = resize/catch_all=ignore

keybind = shift+alt+c=goto_split:up
keybind = shift+alt+t=goto_split:down
keybind = shift+alt+h=goto_split:left
keybind = shift+alt+n=goto_split:right
keybind = ctrl+page_up=previous_tab
keybind = ctrl+page_down=next_tab
# keybind = ctrl+tab=last_active_tab (not implemented upstream yet)

mouse-hide-while-typing = true
copy-on-select = clipboard

